diff --git a/scripts/train_m2.py b/scripts/train_m2.py
index 74cfaef..90ac6be 100644
--- a/scripts/train_m2.py
+++ b/scripts/train_m2.py
@@ -129,6 +129,27 @@ def run_name(args, s):
             + ("_smoke" if args.smoke else ""))
 
 
+def close_tc_pixels(points_by_image, size, device):
+    import numpy as np
+    from scipy.spatial import cKDTree
+
+    pixels = set()
+    for b, points in enumerate(points_by_image):
+        points = points.numpy()
+        if len(points) < 2:
+            continue
+        xy = points[:, :2]
+        nearest = cKDTree(xy).query(xy, k=2)[0][:, 1]
+        selected = (points[:, 2] == 2) & (nearest >= 14) & (nearest < 30)
+        for x, y in np.rint(xy[selected]).astype(int):
+            for row in range(max(0, y - 1), min(size, y + 2)):
+                for col in range(max(0, x - 1), min(size, x + 2)):
+                    pixels.add((b, row, col))
+    if pixels:
+        return torch.as_tensor(sorted(pixels), device=device, dtype=torch.long).T
+    return None
+
+
